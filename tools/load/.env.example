# Copy to tools/load/.env (gitignored). Credentials of the Logto machine-to-machine app used by k6:
# Console → Applications → Machine-to-machine → "ticketmanager-loadtest", with the M2M role
# "load-tester" holding the permission "load:test" of the tickets AND notifications API resources.
LOADTEST_APP_ID=
LOADTEST_APP_SECRET=
# host   = services started by `pnpm dev` on this machine (default)
# docker = services of `pnpm docker:up`
LOAD_TARGET=host

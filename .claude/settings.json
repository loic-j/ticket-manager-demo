{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Skill",
      "TodoWrite",
      "Artifact",
      "Monitor",
      "EnterWorktree",
      "ExitWorktree",
      "ScheduleWakeup"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME*)",
      "Bash(git push --force * main*)",
      "Bash(git push -f * main*)",
      "Bash(docker volume rm * logto-db*)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./infra/.env)",
      "Edit(./pnpm-lock.yaml)",
      "Edit(./apps/tickets-service/src/generated/**)",
      "Edit(./apps/web/AGENTS.md)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pr-review-toolkit@anthropic-plugin-directory": true,
    "commit-commands@anthropic-plugin-directory": true,
    "frontend-design@anthropic-plugin-directory": true,
    "docker-skills@anthropic-plugin-directory": true,
    "opinionated-prisma-skills@anthropic-plugin-directory": true
  },
  "skillOverrides": {
    "docker-skills:docker-agent-config": "off",
    "docker-skills:docker-agent-deploy": "off",
    "docker-skills:docker-agent-run": "off",
    "docker-skills:docker-sandboxes-env": "off",
    "docker-skills:docker-sandboxes-kits": "off",
    "docker-skills:docker-sandboxes-lifecycle": "off",
    "docker-skills:docker-sandboxes-network-credentials": "off"
  }
}

# Copy to infra/.env (gitignored). Read by Docker Compose in full-Docker mode (pnpm docker:up): it
# is the `.env` of the Compose project directory (`infra/`, the folder of the first `-f` file), so
# the `${VAR}` references in docker-compose.yml and compose/*.yml are interpolated from it. Each
# container only receives the variables its service declares; nothing is injected with env_file.

# `web` container, same values as apps/web/.env.local: Logto Console → Applications → ticketmanager-web.
# Required: Compose refuses to start the stack without them.
LOGTO_APP_ID=
LOGTO_APP_SECRET=
LOGTO_COOKIE_SECRET=

# Machine-to-machine app (Console → Applications → Machine-to-machine) holding two roles:
# "Logto Management API access" (directory-service reads user profiles) and "directory-client"
# (notifications-service calls directory-service). Optional for the local stack, which runs these
# services with NODE_ENV=development: empty = notifications fall back to
# NOTIFICATIONS_DEV_FALLBACK_EMAIL and the directory answers "unknown" for every user.
# Production deployments (NODE_ENV=production) require the M2M app.
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=
NOTIFICATIONS_DEV_FALLBACK_EMAIL=dev@ticketmanager.local

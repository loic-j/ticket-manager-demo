{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": [
        "BASE_URL",
        "BROKER_TIMEOUT_MS",
        "DATABASE_URL",
        "EVENTS_EXCHANGE",
        "LOGTO_API_RESOURCE",
        "LOGTO_APP_ID",
        "LOGTO_APP_SECRET",
        "LOGTO_COOKIE_SECRET",
        "LOGTO_ENDPOINT",
        "OUTBOX_BATCH_SIZE",
        "OUTBOX_MAX_ATTEMPTS",
        "OUTBOX_RELAY_ENABLED",
        "OUTBOX_RELAY_INTERVAL_MS",
        "RABBITMQ_URL",
        "TICKETS_API_URL"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false,
      "persistent": true,
      "env": [
        "BASE_URL",
        "BROKER_TIMEOUT_MS",
        "CORS_ORIGIN",
        "DATABASE_URL",
        "EVENTS_EXCHANGE",
        "LOGTO_API_RESOURCE",
        "LOGTO_APP_ID",
        "LOGTO_APP_SECRET",
        "LOGTO_COOKIE_SECRET",
        "LOGTO_ENDPOINT",
        "OUTBOX_BATCH_SIZE",
        "OUTBOX_MAX_ATTEMPTS",
        "OUTBOX_RELAY_ENABLED",
        "OUTBOX_RELAY_INTERVAL_MS",
        "PORT",
        "RABBITMQ_URL",
        "TICKETS_API_URL"
      ]
    },
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:deploy": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "check-types": {
      "dependsOn": ["^build", "db:generate"]
    },
    "lint": {
      "dependsOn": ["^build", "db:generate"]
    },
    "test": {
      "dependsOn": ["^build", "db:generate"],
      "env": ["LOGTO_API_RESOURCE", "LOGTO_ENDPOINT"]
    },
    "test:e2e": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false,
      "env": ["LOGTO_API_RESOURCE", "LOGTO_ENDPOINT"]
    },
    "clean": {
      "cache": false
    }
  }
}

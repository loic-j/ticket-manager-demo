          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (service_name, server_address, le) (rate(http_client_request_duration_seconds_bucket{service_name=~\"$service\"}[5m])))",
          "legendFormat": "{{service_name}} \u2192 {{server_address}}",
          "datasource": {
            "type": "prometheus",

PORT=3001
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000

# Logto (see infra/logto/docker-compose.yml). Issuer = LOGTO_ENDPOINT/oidc
LOGTO_ENDPOINT=http://localhost:3301
# API resource indicator registered in Logto Console → API resources
LOGTO_API_RESOURCE=https://api.ticketmanager.local

# Tickets database (infra/docker-compose.yml → tickets-db)
DATABASE_URL=postgresql://tickets:tickets@localhost:5433/tickets

# RabbitMQ (pnpm infra:up). The outbox relay publishes integration events to EVENTS_EXCHANGE.
RABBITMQ_URL=amqp://ticketmanager:ticketmanager@localhost:5672
EVENTS_EXCHANGE=ticketmanager.events
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=25
BROKER_TIMEOUT_MS=10000

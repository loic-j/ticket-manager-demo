# Copy to .env (gitignored). Loaded by ConfigModule. No database, no broker.
PORT=3003

# Logto: tokens for the directory API resource (Console → API resources)
LOGTO_ENDPOINT=http://localhost:3301
LOGTO_API_RESOURCE=https://directory.ticketmanager.local
# Machine-to-machine app with the "Logto Management API access" role, used to read user profiles.
# Empty in development: every lookup answers "unknown" (the web shows raw user ids). Required when NODE_ENV=production.
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=

# In-memory profile cache: positive entries live DIRECTORY_CACHE_TTL_MS, at most DIRECTORY_CACHE_MAX_SIZE entries.
DIRECTORY_CACHE_TTL_MS=600000
DIRECTORY_CACHE_MAX_SIZE=1000

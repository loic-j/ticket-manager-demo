# Copy to .env (gitignored). Loaded by ConfigModule. No database, no broker.
PORT=3003

# Logto: tokens for the directory API resource (Console → API resources)
LOGTO_ENDPOINT=http://localhost:3301
LOGTO_API_RESOURCE=https://directory.ticketmanager.local
# Machine-to-machine app with the "Logto Management API access" role, used to read user profiles.
# Empty in development: every lookup answers "unknown" (the web shows raw user ids). Required when NODE_ENV=production.
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=
# Resource indicator of the Logto Management API: https://default.logto.app/api on a self-hosted
# instance, https://<tenant-id>.logto.app/api on Logto Cloud. Logto grants the Management API through
# the single scope "all" (LOGTO_MANAGEMENT_API_SCOPE, leave the default).
LOGTO_MANAGEMENT_API_RESOURCE=https://default.logto.app/api
LOGTO_MANAGEMENT_API_SCOPE=all

# In-memory profile cache: positive entries live DIRECTORY_CACHE_TTL_MS, at most DIRECTORY_CACHE_MAX_SIZE entries.
DIRECTORY_CACHE_TTL_MS=600000
DIRECTORY_CACHE_MAX_SIZE=1000

# Telemetry (ADR 004): traces, metrics and logs pushed over OTLP to the Grafana stack of `pnpm infra:up`.
# OTEL_SERVICE_NAME defaults to the package name when started through pnpm; OTEL_SDK_DISABLED=true turns it off.
OTEL_SERVICE_NAME=directory-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Logging: level (trace|debug|info|warn|error|silent) and pretty-printing for the terminal (JSON otherwise).
LOG_LEVEL=info
LOG_PRETTY=true

# Copy to .env (gitignored). Loaded by ConfigModule; Prisma CLI reads DATABASE_URL through prisma.config.ts.
PORT=3002
CORS_ORIGIN=http://localhost:3000

# Own PostgreSQL (pnpm infra:up → notifications-db on 5434), separate from tickets and Logto.
DATABASE_URL=postgresql://notifications:notifications@localhost:5434/notifications

# Logto: tokens for the notifications API resource (Console → API resources)
LOGTO_ENDPOINT=http://localhost:3301
LOGTO_API_RESOURCE=https://notifications.ticketmanager.local
# Recipient emails come from directory-service (synchronous call, M2M token for its resource).
DIRECTORY_API_URL=http://localhost:3003
# Machine-to-machine app holding the "directory-client" role (permission read:users on the directory resource).
# Leave empty in development to send every email to NOTIFICATIONS_DEV_FALLBACK_EMAIL (ignored when NODE_ENV=production).
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=
NOTIFICATIONS_DEV_FALLBACK_EMAIL=dev@ticketmanager.local

# RabbitMQ consumer
RABBITMQ_URL=amqp://ticketmanager:ticketmanager@localhost:5672
EVENTS_EXCHANGE=ticketmanager.events
CONSUMER_ENABLED=true
CONSUMER_PREFETCH=10
CONSUMER_DELIVERY_LIMIT=5

# SMTP (pnpm infra:up → Mailpit, inbox at http://localhost:8025)
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Ticket Manager <noreply@ticketmanager.local>

# Email retry worker (main.email-retry.ts): re-sends pending/failed emails
EMAIL_RETRY_INTERVAL_MS=30000
EMAIL_RETRY_DELAY_MS=60000
EMAIL_MAX_ATTEMPTS=5

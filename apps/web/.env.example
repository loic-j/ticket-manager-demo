# Copy to .env.local (gitignored) and fill in from the Logto Console (http://localhost:3302).
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_BASE_URL=http://localhost:3000

LOGTO_ENDPOINT=http://localhost:3301
# Console → Applications → "ticketmanager-web" (Traditional web) → App ID / App secret
LOGTO_APP_ID=
LOGTO_APP_SECRET=
# Any random string of 32+ characters, e.g. `openssl rand -base64 32`
LOGTO_COOKIE_SECRET=

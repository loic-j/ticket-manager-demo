# Tickets database: the relay reads the outbox_messages table of tickets-service (infra/docker-compose.yml → tickets-db)
DATABASE_URL=postgresql://tickets:tickets@localhost:5433/tickets

# RabbitMQ (pnpm infra:up). Integration events are published to EVENTS_EXCHANGE.
RABBITMQ_URL=amqp://ticketmanager:ticketmanager@localhost:5672
EVENTS_EXCHANGE=ticketmanager.events
OUTBOX_RELAY_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=25
BROKER_TIMEOUT_MS=10000

# Telemetry (ADR 004): traces, metrics and logs pushed over OTLP to the Grafana stack of `pnpm infra:up`.
# OTEL_SERVICE_NAME defaults to the package name when started through pnpm; OTEL_SDK_DISABLED=true turns it off.
OTEL_SERVICE_NAME=tickets-relay-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Logging: level (trace|debug|info|warn|error|silent) and pretty-printing for the terminal (JSON otherwise).
LOG_LEVEL=info
LOG_PRETTY=true

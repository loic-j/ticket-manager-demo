{
  "name": "@ticketmanager/outbox",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "sql"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "check-types": "tsc --noEmit",
    "lint": "oxlint --type-aware src/",
    "test": "vitest run",
    "test:int": "vitest run --config ./vitest.config.int.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@ticketmanager/events": "workspace:*",
    "@ticketmanager/telemetry": "workspace:*",
    "amqplib": "^2.2.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ticketmanager/typescript-config": "workspace:*",
    "@types/amqplib": "^0.10.8",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

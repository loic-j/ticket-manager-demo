{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push --delete *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git restore *)",
      "Bash(git branch -D *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git rebase *)",
      "Bash(git commit --amend*)",
      "Bash(docker compose * down -v*)",
      "Bash(docker compose * down --volumes*)",
      "Bash(docker compose * down --rmi*)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune*)",
      "Bash(docker system prune*)",
      "Bash(docker rm -f *)",
      "Bash(docker rmi *)",
      "Bash(* prisma migrate reset*)",
      "Bash(* prisma db push*)",
      "Bash(* prisma db execute*)",
      "Bash(* psql *)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(chmod -R *)",
      "Bash(chown -R *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME*)",
      "Bash(git push --force * main*)",
      "Bash(git push -f * main*)",
      "Bash(docker volume rm * logto-db*)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./infra/.env)",
      "Edit(./pnpm-lock.yaml)",
      "Edit(./apps/tickets-service/src/generated/**)",
      "Edit(./apps/web/AGENTS.md)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pr-review-toolkit@anthropic-plugin-directory": true,
    "commit-commands@anthropic-plugin-directory": true,
    "frontend-design@anthropic-plugin-directory": true,
    "docker-skills@anthropic-plugin-directory": true,
    "opinionated-prisma-skills@anthropic-plugin-directory": true
  },
  "skillOverrides": {
    "docker-skills:docker-agent-config": "off",
    "docker-skills:docker-agent-deploy": "off",
    "docker-skills:docker-agent-run": "off",
    "docker-skills:docker-sandboxes-env": "off",
    "docker-skills:docker-sandboxes-kits": "off",
    "docker-skills:docker-sandboxes-lifecycle": "off",
    "docker-skills:docker-sandboxes-network-credentials": "off"
  }
}

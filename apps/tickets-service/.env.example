PORT=3001
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000

# Logto (see infra/docker-compose.yml). Issuer = LOGTO_ENDPOINT/oidc
LOGTO_ENDPOINT=http://localhost:3301
# API resource indicator registered in Logto Console → API resources
LOGTO_API_RESOURCE=https://api.ticketmanager.local

# Tickets database (infra/docker-compose.yml → tickets-db)
DATABASE_URL=postgresql://tickets:tickets@localhost:5433/tickets

# Read cache (infra/docker-compose.yml → valkey, Redis-compatible). Query results are cached for
# CACHE_TTL_MS and evicted after every committed change; a cache round trip slower than
# CACHE_TIMEOUT_MS or an unreachable cache is a miss (the API keeps working from the database).
# CACHE_ENABLED=false bypasses the cache entirely.
CACHE_ENABLED=true
CACHE_URL=redis://localhost:6379
CACHE_TTL_MS=60000
CACHE_TIMEOUT_MS=250
CACHE_KEY_PREFIX=tickets:

# Telemetry (ADR 004): traces, metrics and logs pushed over OTLP to the Grafana stack of `pnpm infra:up`.
# OTEL_SERVICE_NAME defaults to the package name when started through pnpm; OTEL_SDK_DISABLED=true turns it off.
OTEL_SERVICE_NAME=tickets-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Logging: level (trace|debug|info|warn|error|silent) and pretty-printing for the terminal (JSON otherwise).
LOG_LEVEL=info
LOG_PRETTY=true

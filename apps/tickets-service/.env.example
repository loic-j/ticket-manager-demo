PORT=3001
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000

# Logto (see infra/logto/docker-compose.yml). Issuer = LOGTO_ENDPOINT/oidc
LOGTO_ENDPOINT=http://localhost:3301
# API resource indicator registered in Logto Console → API resources
LOGTO_API_RESOURCE=https://api.ticketmanager.local

# Tickets database (infra/docker-compose.yml → tickets-db)
DATABASE_URL=postgresql://tickets:tickets@localhost:5433/tickets

        }
      }
    },
    {
      "type": "timeseries",
      "title": "Outgoing p95 latency",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",

{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": [
        "LOGTO_API_RESOURCE",
        "LOGTO_APP_ID",
        "LOGTO_APP_SECRET",
        "LOGTO_COOKIE_SECRET",
        "LOGTO_ENDPOINT",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_BASE_URL"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "CORS_ORIGIN",
        "LOGTO_API_RESOURCE",
        "LOGTO_APP_ID",
        "LOGTO_APP_SECRET",
        "LOGTO_COOKIE_SECRET",
        "LOGTO_ENDPOINT",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_BASE_URL",
        "PORT"
      ]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["LOGTO_ENDPOINT", "LOGTO_API_RESOURCE"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["LOGTO_ENDPOINT", "LOGTO_API_RESOURCE"]
    },
    "clean": {
      "cache": false
    }
  }
}

{
  "name": "@ticketmanager/tickets-relay-service",
  "version": "0.0.1",
  "description": "Outbox relay of tickets-service: publishes the rows of its outbox to RabbitMQ",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && nest build",
    "dev": "rm -rf dist && nest build && concurrently -n build,relay -c gray,magenta \"nest build --watch --preserveWatchOutput\" \"node --watch --watch-preserve-output dist/main.js\"",
    "start:prod": "node dist/main",
    "check-types": "tsc --noEmit",
    "lint": "oxlint --type-aware src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@ticketmanager/outbox": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@ticketmanager/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "concurrently": "^10.0.6",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "catalog:"
  }
}
